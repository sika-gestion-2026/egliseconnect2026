# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Cle publique (anon / publishable) - JAMAIS la cle service_role ici
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cle service role : usage SERVEUR uniquement (cron, imports). Ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Secret de signature des cookies de session membre (generer : openssl rand -hex 32)
MEMBER_SESSION_SECRET=

# Secret protigeant les endpoints /api/cron/* (generer : openssl rand -hex 32)
CRON_SECRET=

# URL publique du site (utilisee par les emails de reinitialisation de mot de passe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
